# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud -> App settings -> Secrets.
# Never commit real secrets.

# Database. Streamlit Cloud's disk is wiped on restart, so use a hosted Postgres (Neon / Supabase) for real use.
# DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/dbname"

# Optional: create the first admin automatically (otherwise the app shows a one-time setup form).
# ADMIN_EMAIL = "hr@yourcompany.com"
# ADMIN_PASSWORD = "choose-a-strong-password"

# Email delivery: "none" logs emails without sending. Use MailHog/Mailtrap for testing, never real candidates in dev.
EMAIL_BACKEND = "none"
# EMAIL_BACKEND = "smtp"
# SMTP_HOST = "smtp.mailtrap.io"
# SMTP_PORT = 2525
# SMTP_USER = ""
# SMTP_PASSWORD = ""
# SMTP_TLS = true
# EMAIL_FROM = "hr@yourcompany.com"
# SENDGRID_API_KEY = ""
